{
  "name": "easy-merge",
  "version": "1.0.0",
  "description": "Gmail extension: fill _WILDCARDS before sending",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sync-sdk": "mkdir -p public && cp node_modules/@inboxsdk/core/pageWorld.js public/pageWorld.js",
    "predev": "npm run sync-sdk",
    "prebuild": "npm run sync-sdk",
    "postinstall": "npm run sync-sdk",
    "release": "npm run typecheck && npm test && npm run build && mkdir -p release && rm -f release/easymerge-$npm_package_version.zip && cd dist && zip -qr ../release/easymerge-$npm_package_version.zip . -x '.*'",
    "store-assets": "node store/assets-src/render.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@inboxsdk/core": "^2.2.27",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.4",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "private": true
}
