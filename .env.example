# Copy to .env and fill in. Register a free app ID at https://www.inboxsdk.com/
VITE_INBOXSDK_APP_ID=

# Required for merges, which send through the Gmail API (see store/RELEASING.md, "Gmail API setup").
# Without it, sending a merge shows a setup error.
VITE_GOOGLE_OAUTH_CLIENT_ID=
# The extension's public key, which pins its ID so the OAuth redirect URI stays valid. Use the key from
# the Web Store dashboard (Package tab) so unpacked builds get the store item's ID. Left out of release builds.
EXTENSION_PUBLIC_KEY=
